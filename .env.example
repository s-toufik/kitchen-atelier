APP_ENV=debug
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

DEPLOYMENT_ENVIRONMENT=local

CONFIGURATION_DIR=./config

# PostgreSQL -- ingredient/macro catalog, schema `kitchen` inside the shared `homelab` database
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=homelab
DB_POSTGRES_USERNAME=kitchen_atelier
DB_POSTGRES_PASSWORD=change-me

# MongoDB -- recipes and their version history, own database `kitchen`
DB_MONGO_HOST=127.0.0.1
DB_MONGO_PORT=27017
DB_MONGO_DATABASE=kitchen
DB_MONGO_USERNAME=change-me
DB_MONGO_PASSWORD=change-me

# OpenTelemetry collector
OTEL_HOST=
OTEL_PORT=4317

# ANSES CIQUAL dataset (free bulk export, data.gouv.fr) -- fetched by the refresh job; any of csv/xlsx/xls/parquet works
CIQUAL_DATASET_URL=https://www.data.gouv.fr/fr/datasets/r/[dataset-resource-id]

WEB_BASE_PATH=
WEB_DOCS=true
